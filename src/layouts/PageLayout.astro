---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { BreadcrumbItem, FaqItem } from '../components/seo/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  robots?: string;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FaqItem[];
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  image,
  imageAlt,
  type,
  robots,
  breadcrumbs,
  faqs,
  jsonLd,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type={type}
  robots={robots}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content" class="flex-1 w-full">
    <slot />
  </main>
  <Footer />
</BaseLayout>
