---
import { withBase, isActivePath } from '../../lib/paths';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Ingresantes', href: '/ingresantes' },
  { label: 'Vida académica', href: '/vida-academica' },
  { label: 'Calendario', href: '/calendario' },
  { label: 'Herramientas', href: '/herramientas' },
  { label: 'Comunidad', href: '/comunidad' },
  { label: 'Actividades', href: '/actividades' },
];
---

<header class="site-header sticky top-0 z-40 w-full border-b border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Logo institucional -->
    <a
      href={withBase('/')}
      class="flex items-center gap-2.5 no-underline group focus-visible:outline-offset-4 select-none shrink-0"
      aria-label="Ir a la página de inicio de CODES"
    >
      <img
        src={withBase('/brand/logo-claro.svg')}
        alt=""
        class="h-8 sm:h-9 w-auto dark:hidden"
        width="44"
        height="36"
        loading="eager"
      />
      <img
        src={withBase('/brand/logo-oscuro.svg')}
        alt=""
        class="h-8 sm:h-9 w-auto hidden dark:block"
        width="44"
        height="36"
        loading="eager"
      />
      <div class="flex flex-col">
        <span class="font-bold text-base sm:text-lg leading-tight tracking-tight text-[var(--color-text-heading)] group-hover:text-[var(--brand-700)] dark:group-hover:text-[var(--brand-300)] transition-colors">
          CODES
        </span>
        <span class="text-[10px] sm:text-[11px] leading-tight text-[var(--color-text-muted)] font-medium">
          UNLu · Sistemas
        </span>
      </div>
    </a>

    <!-- Navegación desktop -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Navegación principal">
      {
        navItems.map((item) => {
          const active = isActivePath(currentPath, item.href);
          return (
            <a
              href={withBase(item.href)}
              class={`px-3 py-1.5 rounded-lg text-sm font-medium no-underline transition-colors ${
                active
                  ? 'bg-[var(--brand-50)] text-[var(--brand-800)] dark:bg-[var(--brand-950)] dark:text-[var(--brand-200)] font-semibold border border-[var(--brand-200)] dark:border-[var(--brand-800)]'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-heading)] hover:bg-[var(--color-surface-hover)]'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Acciones secundarias: Modo oscuro y botón menú móvil -->
    <div class="flex items-center gap-2">
      <ThemeToggle />

      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] hover:bg-[var(--color-surface-hover)] border border-transparent hover:border-[var(--color-border)] transition-colors min-w-[40px] min-h-[40px]"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Icono Menú (hamburguesa) -->
        <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Icono Cerrar (X) -->
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil desplegable -->
  <div
    id="mobile-menu"
    class="motion-drop hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] px-4 pt-3 pb-5 transition-all shadow-lg"
    aria-label="Menú de navegación móvil"
  >
    <nav class="flex flex-col gap-1.5" aria-label="Enlaces móviles">
      {
        navItems.map((item) => {
          const active = isActivePath(currentPath, item.href);
          return (
            <a
              href={withBase(item.href)}
              class={`flex items-center justify-between px-3.5 py-2.5 rounded-lg text-sm font-medium no-underline transition-colors min-h-[44px] ${
                active
                  ? 'bg-[var(--brand-50)] text-[var(--brand-800)] dark:bg-[var(--brand-950)] dark:text-[var(--brand-200)] font-semibold border border-[var(--brand-200)] dark:border-[var(--brand-800)]'
                  : 'text-[var(--color-text-main)] hover:bg-[var(--color-surface-hover)]'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <svg class="w-4 h-4 text-[var(--color-text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!toggleBtn || !menu || !hamburgerIcon || !closeIcon) return;

    function openMenu() {
      menu.classList.remove('hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    }

    function closeMenu() {
      menu.classList.add('hidden');
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Cerrar al pulsar Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggleBtn.focus();
      }
    });

    // Cerrar al redimensionar a desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  })();
</script>
