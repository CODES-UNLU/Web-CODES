---
import { withBase, isActivePath } from '../../lib/paths';
import ThemeToggle from './ThemeToggle.astro';
import SearchBar from '../ui/SearchBar.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Ingresantes', href: '/ingresantes' },
  { label: 'Vida académica', href: '/vida-academica' },
  { label: 'Calendario', href: '/calendario' },
  { label: 'Herramientas', href: '/herramientas' },
  { label: 'Comunidad', href: '/comunidad' },
  { label: 'Actividades', href: '/actividades' },
];
---

<header class="site-header sticky top-0 z-40 w-full border-b border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Logo institucional -->
    <a
      href={withBase('/')}
      class="flex items-center gap-2.5 no-underline group focus-visible:outline-offset-4 select-none shrink-0"
      aria-label="Ir a la página de inicio de CODES"
    >
      <img
        src={withBase('/brand/logo-claro.svg')}
        alt=""
        class="h-8 sm:h-9 w-auto dark:hidden"
        width="44"
        height="36"
        loading="eager"
      />
      <img
        src={withBase('/brand/logo-oscuro.svg')}
        alt=""
        class="h-8 sm:h-9 w-auto hidden dark:block"
        width="44"
        height="36"
        loading="eager"
      />
      <div class="flex flex-col">
        <span class="font-bold text-base sm:text-lg leading-tight tracking-tight text-[var(--color-text-heading)] group-hover:text-[var(--brand-700)] dark:group-hover:text-[var(--brand-300)] transition-colors">
          CODES
        </span>
        <span class="text-xs leading-tight text-[var(--color-text-muted)] font-medium">
          UNLu · Sistemas
        </span>
      </div>
    </a>

    <!-- Navegación desktop -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-1.5" aria-label="Navegación principal">
      {
        navItems.map((item) => {
          const active = isActivePath(currentPath, item.href);
          return (
            <a
              href={withBase(item.href)}
              class={`px-2.5 lg:px-3 py-1.5 rounded-lg text-sm font-medium no-underline transition-colors ${
                active
                  ? 'bg-[var(--brand-50)] text-[var(--brand-800)] dark:bg-[var(--brand-950)] dark:text-[var(--brand-200)] font-semibold border border-[var(--brand-200)] dark:border-[var(--brand-800)]'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-heading)] hover:bg-[var(--color-surface-hover)]'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Acciones secundarias: Buscador global, Modo oscuro y botón menú móvil -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <button
        type="button"
        id="header-search-toggle"
        class="inline-flex items-center justify-center gap-2 px-2.5 py-2 rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] hover:bg-[var(--color-surface-hover)] border border-transparent hover:border-[var(--color-border)] transition-colors min-w-[40px] min-h-[40px] cursor-pointer"
        aria-label="Abrir buscador del sitio"
        aria-expanded="false"
        aria-controls="header-search-drawer"
        title="Buscar (Ctrl+K)"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden lg:inline text-xs font-medium">Buscar</span>
      </button>

      <ThemeToggle />

      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] hover:bg-[var(--color-surface-hover)] border border-transparent hover:border-[var(--color-border)] transition-colors min-w-[40px] min-h-[40px] cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Icono Menú: las tres barras se transforman en X según aria-expanded -->
        <svg class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="menu-bar menu-bar-top" d="M4 6h16" />
          <path class="menu-bar menu-bar-mid" d="M4 12h16" />
          <path class="menu-bar menu-bar-bot" d="M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Buscador global desplegable disponible en todo el sitio -->
  <div
    id="header-search-drawer"
    class="hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] px-4 sm:px-6 py-3.5 shadow-md"
    aria-label="Buscador rápido del sitio"
  >
    <div class="max-w-2xl mx-auto">
      <SearchBar idPrefix="header-search" />
    </div>
  </div>

  <!-- Menú móvil desplegable -->
  <div
    id="mobile-menu"
    class="menu-panel hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] px-4 pt-3 pb-5 transition-all shadow-lg"
    aria-label="Menú de navegación móvil"
  >
    <nav class="flex flex-col gap-1.5" aria-label="Enlaces móviles">
      {
        navItems.map((item) => {
          const active = isActivePath(currentPath, item.href);
          return (
            <a
              href={withBase(item.href)}
              class={`pressable flex items-center justify-between px-3.5 py-2.5 rounded-lg text-sm font-medium no-underline transition min-h-[44px] ${
                active
                  ? 'bg-[var(--brand-50)] text-[var(--brand-800)] dark:bg-[var(--brand-950)] dark:text-[var(--brand-200)] font-semibold border border-[var(--brand-200)] dark:border-[var(--brand-800)]'
                  : 'text-[var(--color-text-main)] hover:bg-[var(--color-surface-hover)]'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <svg class="w-4 h-4 text-[var(--color-text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const searchToggleBtn = document.getElementById('header-search-toggle');
    const searchPanel = document.getElementById('header-search-drawer');

    function openMenu() {
      if (!menu || !toggleBtn) return;
      closeSearch();
      menu.classList.remove('hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
    }

    function closeMenu() {
      if (!menu || !toggleBtn) return;
      menu.classList.add('hidden');
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
    }

    function openSearch() {
      if (!searchPanel || !searchToggleBtn) return;
      closeMenu();
      searchPanel.classList.remove('hidden');
      searchToggleBtn.setAttribute('aria-expanded', 'true');
      searchToggleBtn.setAttribute('aria-label', 'Cerrar buscador del sitio');
      const input = document.getElementById('header-search-input');
      if (input) input.focus();
    }

    function closeSearch() {
      if (!searchPanel || !searchToggleBtn) return;
      searchPanel.classList.add('hidden');
      searchToggleBtn.setAttribute('aria-expanded', 'false');
      searchToggleBtn.setAttribute('aria-label', 'Abrir buscador del sitio');
    }

    if (toggleBtn && menu) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeMenu();
        });
      });
    }

    if (searchToggleBtn && searchPanel) {
      searchToggleBtn.addEventListener('click', () => {
        const isExpanded = searchToggleBtn.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          closeSearch();
        } else {
          openSearch();
        }
      });
    }

    // Cerrar al tocar o hacer clic fuera del menú móvil o del panel de búsqueda
    document.addEventListener('pointerdown', (e) => {
      const target = e.target;
      if (
        menu &&
        toggleBtn &&
        toggleBtn.getAttribute('aria-expanded') === 'true' &&
        !menu.contains(target) &&
        !toggleBtn.contains(target)
      ) {
        closeMenu();
      }
      if (
        searchPanel &&
        searchToggleBtn &&
        searchToggleBtn.getAttribute('aria-expanded') === 'true' &&
        !searchPanel.contains(target) &&
        !searchToggleBtn.contains(target)
      ) {
        closeSearch();
      }
    });

    // Atajos de teclado: Escape y Ctrl/Cmd+K (o '/' fuera de inputs)
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (searchToggleBtn && searchToggleBtn.getAttribute('aria-expanded') === 'true') {
          closeSearch();
          searchToggleBtn.focus();
          return;
        }
        if (toggleBtn && toggleBtn.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          toggleBtn.focus();
        }
      } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (searchToggleBtn && searchToggleBtn.getAttribute('aria-expanded') === 'true') {
          closeSearch();
        } else {
          openSearch();
        }
      } else if (
        e.key === '/' &&
        !e.ctrlKey &&
        !e.metaKey &&
        !e.altKey &&
        !(e.target instanceof HTMLInputElement) &&
        !(e.target instanceof HTMLTextAreaElement) &&
        !(e.target instanceof HTMLSelectElement)
      ) {
        e.preventDefault();
        openSearch();
      }
    });

    // Cerrar menú móvil al redimensionar a desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && toggleBtn && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  })();
</script>
