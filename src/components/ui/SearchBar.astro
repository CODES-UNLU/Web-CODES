---
import { searchIndex } from '../../lib/searchData';
import { withBase } from '../../lib/paths';

interface Props {
  placeholder?: string;
  class?: string;
}

const {
  placeholder = 'Buscar trámites, ingresantes, SAWEB, PlatDig, fechas...',
  class: className = '',
} = Astro.props;

// Pasamos el índice serializado con las rutas ya resueltas con base
const indexedData = searchIndex.map((item) => ({
  ...item,
  resolvedUrl: withBase(item.url),
}));
---

<div class={`relative w-full max-w-2xl mx-auto search-container ${className}`}>
  <!-- Input accesible -->
  <div class="relative flex items-center">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--color-text-muted)]" aria-hidden="true">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <input
      type="search"
      id="site-search-input"
      class="w-full pl-10 pr-10 py-3 sm:py-3.5 bg-[var(--color-surface)] text-[var(--color-text-heading)] placeholder:text-[var(--color-text-muted)] border border-[var(--color-border)] rounded-xl text-sm sm:text-base transition-all shadow-xs focus:border-[var(--brand-400)] focus:ring-2 focus:ring-[var(--brand-200)] dark:focus:ring-[var(--brand-900)] outline-none"
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
      aria-autocomplete="list"
      aria-controls="search-results-list"
      aria-expanded="false"
      role="combobox"
      aria-label="Buscar contenidos y trámites en la web de CODES"
    />

    <!-- Botón para limpiar búsqueda -->
    <button
      type="button"
      id="search-clear-btn"
      class="absolute inset-y-0 right-0 pr-3 flex items-center text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] hidden"
      aria-label="Limpiar término de búsqueda"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Panel de resultados accesible -->
  <div
    id="search-results-panel"
    class="absolute left-0 right-0 top-full mt-2 z-50 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl shadow-lg p-2 max-h-96 overflow-y-auto hidden"
    role="region"
    aria-live="polite"
    aria-label="Resultados de búsqueda"
  >
    <div id="search-status-message" class="p-3 text-xs text-[var(--color-text-muted)]"></div>
    <ul id="search-results-list" class="space-y-1 list-none p-0 m-0" role="listbox">
      <!-- Se puebla dinámicamente con JavaScript -->
    </ul>
  </div>
</div>

<!-- Datos embebidos para búsqueda estática en el cliente -->
<script is:inline define:vars={{ indexedData }}>
  window.__CODES_SEARCH_INDEX__ = indexedData;
</script>

<script is:inline>
  (() => {
    const input = document.getElementById('site-search-input');
    const panel = document.getElementById('search-results-panel');
    const list = document.getElementById('search-results-list');
    const statusMsg = document.getElementById('search-status-message');
    const clearBtn = document.getElementById('search-clear-btn');

    if (!input || !panel || !list || !statusMsg || !clearBtn) return;

    const data = window.__CODES_SEARCH_INDEX__ || [];
    let activeIndex = -1;

    function normalizeText(text) {
      return text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function renderResults(query) {
      const q = normalizeText(query.trim());

      if (!q) {
        panel.classList.add('hidden');
        clearBtn.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        list.innerHTML = '';
        activeIndex = -1;
        return;
      }

      clearBtn.classList.remove('hidden');

      const matches = data.filter((item) => {
        const titleNorm = normalizeText(item.title);
        const descNorm = normalizeText(item.description);
        const catNorm = normalizeText(item.category);
        const keywordsNorm = item.keywords.map(normalizeText).join(' ');

        return (
          titleNorm.includes(q) ||
          descNorm.includes(q) ||
          catNorm.includes(q) ||
          keywordsNorm.includes(q)
        );
      });

      list.innerHTML = '';
      activeIndex = -1;

      if (matches.length === 0) {
        statusMsg.textContent = 'No encontramos guías ni trámites que coincidan con tu búsqueda.';
        list.innerHTML = `
          <li class="p-3 text-xs text-[var(--color-text-muted)]">
            Probá buscando términos frecuentes como:
            <span class="inline-flex flex-wrap gap-1 mt-2">
              <button type="button" class="search-suggestion text-[var(--color-interactive)] hover:underline cursor-pointer bg-[var(--color-bg-subtle)] px-2 py-0.5 rounded border border-[var(--color-border-subtle)]">ingresantes</button>
              <button type="button" class="search-suggestion text-[var(--color-interactive)] hover:underline cursor-pointer bg-[var(--color-bg-subtle)] px-2 py-0.5 rounded border border-[var(--color-border-subtle)]">saweb</button>
              <button type="button" class="search-suggestion text-[var(--color-interactive)] hover:underline cursor-pointer bg-[var(--color-bg-subtle)] px-2 py-0.5 rounded border border-[var(--color-border-subtle)]">platdig</button>
              <button type="button" class="search-suggestion text-[var(--color-interactive)] hover:underline cursor-pointer bg-[var(--color-bg-subtle)] px-2 py-0.5 rounded border border-[var(--color-border-subtle)]">aulas virtuales</button>
              <button type="button" class="search-suggestion text-[var(--color-interactive)] hover:underline cursor-pointer bg-[var(--color-bg-subtle)] px-2 py-0.5 rounded border border-[var(--color-border-subtle)]">boleto</button>
              <button type="button" class="search-suggestion text-[var(--color-interactive)] hover:underline cursor-pointer bg-[var(--color-bg-subtle)] px-2 py-0.5 rounded border border-[var(--color-border-subtle)]">finales</button>
            </span>
          </li>
        `;

        list.querySelectorAll('.search-suggestion').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            input.value = e.target.textContent;
            renderResults(input.value);
            input.focus();
          });
        });
      } else {
        statusMsg.textContent = `${matches.length} resultado${matches.length > 1 ? 's' : ''} encontrado${matches.length > 1 ? 's' : ''}:`;

        matches.forEach((item, idx) => {
          const li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.id = `search-result-${idx}`;

          li.innerHTML = `
            <a href="${item.resolvedUrl}" class="flex flex-col gap-0.5 p-3 rounded-lg no-underline hover:bg-[var(--color-surface-hover)] focus:bg-[var(--color-surface-hover)] transition-colors">
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-semibold text-[var(--color-text-heading)]">${item.title}</span>
                <span class="text-[10px] uppercase font-bold text-[var(--brand-700)] dark:text-[var(--brand-300)] bg-[var(--brand-50)] dark:bg-[var(--brand-950)] px-2 py-0.5 rounded border border-[var(--brand-200)] dark:border-[var(--brand-800)] shrink-0">${item.category}</span>
              </div>
              <p class="text-xs text-[var(--color-text-muted)] line-clamp-2 m-0">${item.description}</p>
            </a>
          `;

          list.appendChild(li);
        });
      }

      panel.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    }

    input.addEventListener('input', (e) => {
      renderResults(e.target.value);
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      renderResults('');
      input.focus();
    });

    // Navegación por teclado (Flechas, Enter, Escape)
    input.addEventListener('keydown', (e) => {
      const items = list.querySelectorAll('li[role="option"] a');
      if (items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % items.length;
        items[activeIndex].focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        items[activeIndex].focus();
      } else if (e.key === 'Escape') {
        panel.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    // Cerrar al hacer clic fuera
    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !panel.contains(e.target)) {
        panel.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    // Reabrir al hacer foco si hay valor
    input.addEventListener('focus', () => {
      if (input.value.trim()) {
        renderResults(input.value);
      }
    });
  })();
</script>
