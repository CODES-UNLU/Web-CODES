---
interface Props {
  title: string;
  badge?: string;
  open?: boolean;
  class?: string;
  id?: string;
}

const {
  title,
  badge,
  open = false,
  class: className = '',
  id,
} = Astro.props;
---

<details
  class={`group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-colors hover:border-[var(--brand-300)] ${className}`}
  open={open}
  id={id}
>
  <summary class="flex items-center justify-between gap-4 p-4 sm:p-5 cursor-pointer list-none font-semibold text-[var(--color-text-heading)] select-none focus-visible:outline-2 focus-visible:outline-[var(--color-interactive-focus)] rounded-xl">
    <span class="flex items-center gap-2.5 min-w-0">
      <span class="text-base sm:text-lg">{title}</span>
      {badge && (
        <span class="text-xs font-normal text-[var(--color-text-muted)] bg-[var(--color-bg-subtle)] px-2 py-0.5 rounded border border-[var(--color-border-subtle)]">
          {badge}
        </span>
      )}
    </span>
    <span class="shrink-0 text-[var(--color-text-muted)] transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </span>
  </summary>
  <div class="px-4 pb-5 sm:px-5 sm:pb-6 pt-1 text-sm text-[var(--color-text-main)] border-t border-[var(--color-border-subtle)] leading-relaxed prose prose-sm max-w-none">
    <slot />
  </div>
</details>
