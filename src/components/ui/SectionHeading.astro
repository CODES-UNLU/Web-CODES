---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  level?: 1 | 2 | 3;
  class?: string;
}

const {
  title,
  subtitle,
  level = 2,
  class: className = '',
} = Astro.props;

const Tag = `h${level}` as 'h1' | 'h2' | 'h3';
const headingStylesMap = {
  1: 'text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-text-heading)]',
  2: 'text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text-heading)]',
  3: 'text-xl sm:text-2xl font-semibold tracking-tight text-[var(--color-text-heading)]',
} as const;
const headingStyles = headingStylesMap[level];
---

<header class={`mb-6 sm:mb-8 ${className}`}>
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <div>
      <Tag class={headingStyles}>{title}</Tag>
      {subtitle && (
        <p class="mt-2 text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-2xl">
          {subtitle}
        </p>
      )}
    </div>
    <div class="shrink-0 flex items-center gap-2">
      <slot name="action" />
    </div>
  </div>
</header>
