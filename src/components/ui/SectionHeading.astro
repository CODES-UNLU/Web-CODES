---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  level?: 2 | 3;
  class?: string;
}

const {
  title,
  subtitle,
  badge,
  level = 2,
  class: className = '',
} = Astro.props;

const Tag = `h${level}` as 'h2' | 'h3';
const headingStyles = level === 2 
  ? 'text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text-heading)]'
  : 'text-xl sm:text-2xl font-semibold tracking-tight text-[var(--color-text-heading)]';
---

<header class={`mb-6 sm:mb-8 ${className}`}>
  {badge && (
    <div class="mb-2">
      <span class="inline-block text-xs font-semibold text-[var(--brand-700)] dark:text-[var(--brand-300)] bg-[var(--brand-50)] dark:bg-[var(--brand-950)] px-2.5 py-1 rounded-md border border-[var(--brand-200)] dark:border-[var(--brand-800)]">
        {badge}
      </span>
    </div>
  )}
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <div>
      <Tag class={headingStyles}>{title}</Tag>
      {subtitle && (
        <p class="mt-1.5 text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-2xl">
          {subtitle}
        </p>
      )}
    </div>
    <div class="shrink-0 flex items-center gap-2">
      <slot name="action" />
    </div>
  </div>
</header>
