---
interface Props {
  variant?: 'info' | 'warning' | 'success' | 'danger' | 'brand';
  title?: string;
  class?: string;
}

const {
  variant = 'info',
  title,
  class: className = '',
} = Astro.props;

const styles = {
  info: {
    container: 'bg-[var(--color-info-bg)] border-[var(--color-info-border)] text-[var(--color-text-main)]',
    title: 'text-[var(--color-info)]',
    icon: `<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  warning: {
    container: 'bg-[var(--color-warning-bg)] border-[var(--color-warning-border)] text-[var(--color-text-main)]',
    title: 'text-[var(--color-warning)]',
    icon: `<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`,
  },
  success: {
    container: 'bg-[var(--color-success-bg)] border-[var(--color-success-border)] text-[var(--color-text-main)]',
    title: 'text-[var(--color-success)]',
    icon: `<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  danger: {
    container: 'bg-[var(--color-danger-bg)] border-[var(--color-danger-border)] text-[var(--color-text-main)]',
    title: 'text-[var(--color-danger)]',
    icon: `<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  brand: {
    container: 'bg-[var(--brand-50)] border-[var(--brand-200)] text-[var(--color-text-main)] dark:bg-[var(--brand-950)] dark:border-[var(--brand-800)]',
    title: 'text-[var(--brand-700)] dark:text-[var(--brand-300)]',
    icon: `<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
};

const current = styles[variant];
---

<aside class={`flex gap-3.5 p-4 sm:p-5 rounded-xl border text-sm leading-relaxed ${current.container} ${className}`} role="note">
  <div class={`mt-0.5 ${current.title}`} set:html={current.icon} aria-hidden="true" />
  <div class="flex-1 min-w-0">
    {title && <h3 class={`text-sm font-bold mb-1 ${current.title}`}>{title}</h3>}
    <div class="prose-sm space-y-1">
      <slot />
    </div>
  </div>
</aside>
