---
import type { ActivityItem } from '../data/activitiesData';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';

interface Props {
  activity: ActivityItem;
}

const { activity } = Astro.props;

const typeVariant = {
  Charla: 'brand',
  Taller: 'info',
  Podcast: 'warning',
  Entrevista: 'success',
  Evento: 'neutral',
} as const;
---

<article class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 sm:p-6 shadow-xs flex flex-col justify-between transition-all hover:border-[var(--brand-400)]" id={activity.id}>
  <div>
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <Badge variant={typeVariant[activity.type] || 'neutral'}>{activity.type}</Badge>
        <span class="text-xs text-[var(--color-text-muted)] font-medium">
          {activity.platform}
        </span>
      </div>
      <span class="text-xs text-[var(--color-text-muted)]">
        {activity.dateDisplay}
      </span>
    </div>

    <h3 class="text-base sm:text-lg font-bold text-[var(--color-text-heading)] mb-2 leading-snug">
      {activity.title}
    </h3>

    {
      activity.speaker && (
        <p class="text-xs font-medium text-[var(--brand-700)] dark:text-[var(--brand-300)] mb-3">
          {activity.speaker}
        </p>
      )
    }

    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
      {activity.description}
    </p>
  </div>

  <footer class="pt-4 border-t border-[var(--color-border-subtle)] flex items-center justify-between gap-3 text-xs">
    {
      activity.videoDuration && (
        <span class="text-[var(--color-text-muted)] flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{activity.videoDuration}</span>
        </span>
      )
    }

    <div class="ml-auto">
      {
        activity.externalUrl ? (
          <Button
            href={activity.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
            size="sm"
          >
            <span>Ver en {activity.platform}</span>
            <span aria-hidden="true">↗</span>
          </Button>
        ) : (
          <span class="text-xs font-medium text-[var(--color-text-muted)] italic">
            {activity.status}
          </span>
        )
      }
    </div>
  </footer>
</article>
