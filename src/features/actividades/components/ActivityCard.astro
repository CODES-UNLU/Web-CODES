---
import type { ActivityItem } from '../data/activitiesData';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import YouTubeFacade from './YouTubeFacade.astro';

interface Props {
  activity: ActivityItem;
}

const { activity } = Astro.props;

const typeVariant = {
  Charla: 'brand',
  Taller: 'info',
  Podcast: 'warning',
  Entrevista: 'success',
  Evento: 'neutral',
} as const;

const hasVideo = Boolean(activity.youtubeId);
---

<article
  class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl shadow-xs flex flex-col overflow-hidden transition-all hover:border-[var(--brand-400)]"
  id={activity.id}
>
  {
    activity.youtubeId && (
      <YouTubeFacade id={activity.youtubeId} title={activity.title} duration={activity.videoDuration} />
    )
  }

  <div class="flex flex-col flex-1 p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <Badge variant={typeVariant[activity.type] || 'neutral'}>{activity.type}</Badge>
        {
          !hasVideo && (
            <span class="text-xs text-[var(--color-text-muted)] font-medium">{activity.platform}</span>
          )
        }
      </div>
      <span class="text-xs text-[var(--color-text-muted)]">
        {activity.dateDisplay}
      </span>
    </div>

    <h3 class="text-base sm:text-lg font-bold text-[var(--color-text-heading)] mb-1 leading-snug">
      {activity.title}
    </h3>

    {
      activity.speaker && (
        <p class="text-xs sm:text-sm font-medium text-[var(--brand-700)] dark:text-[var(--brand-300)] mb-3">
          {activity.speaker}
        </p>
      )
    }

    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
      {activity.description}
    </p>

    <footer class="mt-auto pt-4 border-t border-[var(--color-border-subtle)] flex items-center justify-between gap-3 text-xs">
      {
        hasVideo ? (
          // En el teléfono, abrir la app de YouTube suele ser más cómodo que el reproductor embebido
          <a
            href={activity.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-auto inline-flex items-center gap-1 font-semibold text-[var(--color-interactive)] no-underline hover:underline"
          >
            <span>Abrir en YouTube</span>
            <span aria-hidden="true">↗</span>
          </a>
        ) : activity.externalUrl ? (
          <Button
            href={activity.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
            size="sm"
            class="ml-auto"
          >
            <span>Ver en {activity.platform}</span>
            <span aria-hidden="true">↗</span>
          </Button>
        ) : (
          <span class="ml-auto text-xs font-medium text-[var(--color-text-muted)] italic">
            {activity.status}
          </span>
        )
      }
    </footer>
  </div>
</article>
