---
import {
  universityPlatforms,
  platformFaqs,
} from '../data/platformsData';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import Callout from '../../../components/ui/Callout.astro';
import Accordion from '../../../components/ui/Accordion.astro';

interface Props {
  id?: string;
  class?: string;
}

const { id = 'plataformas-unlu', class: className = '' } = Astro.props;
---

<section class={`space-y-8 ${className}`} id={id}>
  <div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <span class="text-xs font-bold text-[var(--brand-700)] dark:text-[var(--brand-300)] uppercase tracking-wider block mb-1">
          Guía verificada de sistemas
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-heading)] m-0">
          Plataformas y servicios digitales de la UNLu
        </h2>
      </div>
      <Badge variant="info">Fuentes oficiales UNLu</Badge>
    </div>

    <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-3xl">
      La Universidad Nacional de Luján cuenta con plataformas específicas para cada necesidad. Es fundamental distinguir entre el <strong>campus virtual de cursadas (PlatDig)</strong> y los <strong>sistemas de gestión académica</strong>, cuyo acceso depende de tu cohorte de ingreso.
    </p>

    <!-- Callout de distinción de cohorte -->
    <Callout variant="warning" title="Atención: Acceso según cohorte de ingreso">
      <p class="mb-2">
        Para inscripciones a materias, exámenes y certificados, la UNLu dispone de dos portales diferenciados:
      </p>
      <ul class="space-y-1 list-disc pl-4 text-xs sm:text-sm">
        <li>
          <strong>Cohortes anteriores a 2027:</strong> Utilizan <strong>SAWEB (Servicios Académicos Web)</strong>.
        </li>
        <li>
          <strong>Cohorte 2027 en adelante:</strong> Utilizan el <strong>Sistema de Gestión de Estudiantes</strong> oficial.
        </li>
      </ul>
      <p class="text-xs mt-2 text-[var(--color-text-muted)]">
        *No confundas el año calendario en el que consultas esta web con tu año de cohorte de ingreso a la carrera.
      </p>
    </Callout>
  </div>

  <!-- TARJETAS DE LAS 3 PLATAFORMAS PRINCIPALES -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      universityPlatforms.map((platform) => (
        <article class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 sm:p-6 shadow-xs flex flex-col justify-between transition-all hover:border-[var(--brand-400)]">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-[var(--brand-50)] dark:bg-[var(--brand-950)] text-[var(--brand-800)] dark:text-[var(--brand-200)] border border-[var(--brand-200)] dark:border-[var(--brand-800)]">
                {platform.id === 'platdig' ? 'Aulas Virtuales' : 'Gestión Académica'}
              </span>
              <span class="text-[11px] text-[var(--color-text-muted)] font-medium">UNLu Oficial</span>
            </div>

            <h3 class="text-lg font-bold text-[var(--color-text-heading)] mb-1">
              {platform.name}
            </h3>
            <p class="text-xs font-semibold text-[var(--color-interactive)] mb-3">
              {platform.commonName}
            </p>

            <div class="p-2.5 rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border-subtle)] text-xs text-[var(--color-text-muted)] mb-4">
              <span class="font-bold text-[var(--color-text-heading)] block mb-0.5">Destinado a:</span>
              <span>{platform.targetAudience}</span>
            </div>

            <p class="text-xs sm:text-sm text-[var(--color-text-main)] leading-relaxed mb-4">
              {platform.purpose}
            </p>

            <div class="space-y-1.5 mb-5">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] block">
                Funciones principales:
              </span>
              <ul class="space-y-1 list-disc pl-4 text-xs text-[var(--color-text-main)]">
                {platform.keyFunctions.map((fn) => (
                  <li>{fn}</li>
                ))}
              </ul>
            </div>

            {platform.hasMobileApp && (
              <div class="p-2.5 rounded-lg bg-[var(--brand-50)] dark:bg-[var(--brand-950)] border border-[var(--brand-200)] dark:border-[var(--brand-900)] text-xs text-[var(--brand-800)] dark:text-[var(--brand-200)] mb-4 flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                <span>Acceso móvil disponible con <strong>{platform.mobileAppName}</strong></span>
              </div>
            )}
          </div>

          <footer class="pt-4 border-t border-[var(--color-border-subtle)] space-y-3">
            <Button
              href={platform.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="outline"
              size="sm"
              class="w-full text-center"
            >
              <span>Acceder a {platform.id === 'platdig' ? 'PlatDig' : platform.id === 'saweb' ? 'SAWEB' : 'Gestión Estudiantes'}</span>
              <span aria-hidden="true">↗</span>
            </Button>

            <div class="text-[11px] text-[var(--color-text-muted)] leading-tight">
              <span>Fuente: </span>
              <a href={platform.verification.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline text-[var(--color-text-muted)] hover:text-[var(--color-interactive)]">
                {platform.verification.officialSource}
              </a>
            </div>
          </footer>
        </article>
      ))
    }
  </div>

  <!-- PREGUNTAS FRECUENTES RESUELTAS DE FORMA DIRECTA -->
  <div class="bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-xl p-5 sm:p-8 space-y-4">
    <div class="mb-2">
      <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] m-0">
        Preguntas frecuentes sobre plataformas de la UNLu
      </h3>
      <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1">
        Respuestas directas para saber a qué sistema entrar en cada momento de tu cursada.
      </p>
    </div>

    <div class="space-y-3">
      {
        platformFaqs.map((faq, idx) => (
          <Accordion title={faq.question} badge={faq.highlightPlatform} open={idx === 0}>
            <p class="mb-2">{faq.answer}</p>
            {faq.appNote && (
              <p class="text-xs font-medium text-[var(--brand-700)] dark:text-[var(--brand-300)] mt-2">
                📱 {faq.appNote}
              </p>
            )}
            {faq.platformUrl && (
              <div class="pt-2">
                <a
                  href={faq.platformUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--color-interactive)] underline"
                >
                  <span>Ir al sitio oficial de {faq.highlightPlatform}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            )}
          </Accordion>
        ))
      }
    </div>
  </div>
</section>
