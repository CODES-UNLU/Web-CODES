---
import {
  universityPlatforms,
  platformFaqs,
} from '../data/platformsData';
import Button from '../../../components/ui/Button.astro';
import Callout from '../../../components/ui/Callout.astro';
import Accordion from '../../../components/ui/Accordion.astro';

interface Props {
  id?: string;
  class?: string;
}

const { id = 'plataformas-unlu', class: className = '' } = Astro.props;
---

<section class={`space-y-8 ${className}`} id={id}>
  <div class="space-y-4">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text-heading)] m-0">
        Plataformas y servicios digitales de la UNLu
      </h2>
      <span class="text-xs font-medium text-[var(--color-text-muted)]">Fuentes oficiales UNLu</span>
    </div>

    <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-3xl">
      La Universidad Nacional de Luján cuenta con plataformas específicas para cada necesidad. Distinguí entre el <strong>campus virtual de cursadas, Educativa (Aula Virtual),</strong> y los <strong>sistemas de gestión académica</strong>, cuyo acceso depende de tu cohorte de ingreso.
    </p>

    <!-- Único Callout de la página: distinción crítica por cohorte -->
    <Callout variant="warning" title="Atención: Acceso según cohorte de ingreso">
      <p class="mb-2">
        Para inscripciones a materias, exámenes y certificados, la UNLu dispone de dos portales diferenciados:
      </p>
      <ul class="space-y-1 list-disc pl-4 text-sm">
        <li>
          <strong>Cohortes anteriores a 2027:</strong> Utilizan <strong>SAWEB (Servicios Académicos Web)</strong>.
        </li>
        <li>
          <strong>Cohorte 2027 en adelante:</strong> Utilizan el <strong>Sistema de Gestión de Estudiantes</strong> oficial.
        </li>
      </ul>
      <p class="text-xs mt-2 text-[var(--color-text-muted)]">
        *Tu cohorte es el año en que te inscribiste a la carrera por primera vez, no el año actual.
      </p>
    </Callout>
  </div>

  <!-- TARJETAS DE LAS 3 PLATAFORMAS PRINCIPALES (Sin cajas anidadas) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      universityPlatforms.map((platform) => (
        <article class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 sm:p-6 shadow-xs flex flex-col justify-between transition-all hover:border-[var(--brand-400)]">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3 text-xs">
              <span class="font-semibold text-[var(--brand-700)] dark:text-[var(--brand-300)]">
                {platform.id === 'platdig' ? 'Aula Virtual' : 'Gestión Académica'}
              </span>
              <span class="text-[var(--color-text-muted)] font-medium">UNLu Oficial</span>
            </div>

            <h3 class="text-lg font-bold text-[var(--color-text-heading)] mb-1 mt-0">
              {platform.name}
            </h3>
            <p class="text-xs font-semibold text-[var(--color-interactive)] mb-3">
              {platform.commonName}
            </p>

            <p class="text-sm text-[var(--color-text-main)] leading-relaxed mb-4">
              {platform.purpose}
            </p>

            <div class="pt-3 border-t border-[var(--color-border-subtle)] text-sm mb-4 space-y-1">
              <span class="text-xs font-bold text-[var(--color-text-heading)] block">Destinado a</span>
              <span class="text-[var(--color-text-muted)] block leading-relaxed">{platform.targetAudience}</span>
            </div>

            <div class="pt-3 border-t border-[var(--color-border-subtle)] space-y-1.5 mb-5">
              <span class="text-xs font-bold text-[var(--color-text-heading)] block">
                Funciones principales
              </span>
              <ul class="space-y-1 list-disc pl-4 text-sm text-[var(--color-text-main)]">
                {platform.keyFunctions.map((fn) => (
                  <li>{fn}</li>
                ))}
              </ul>
            </div>

            {platform.hasMobileApp && (
              <p class="pt-3 border-t border-[var(--color-border-subtle)] text-xs font-medium text-[var(--brand-700)] dark:text-[var(--brand-300)] mb-4 flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                <span>Acceso móvil disponible con <strong>{platform.mobileAppName}</strong></span>
              </p>
            )}
          </div>

          <footer class="pt-4 border-t border-[var(--color-border-subtle)] space-y-3">
            <Button
              href={platform.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="outline"
              size="sm"
              class="w-full text-center min-h-[42px]"
            >
              <span>Acceder a {platform.id === 'platdig' ? 'Educativa' : platform.id === 'saweb' ? 'SAWEB' : 'Gestión Estudiantes'}</span>
              <span aria-hidden="true">↗</span>
            </Button>

            <div class="text-xs text-[var(--color-text-muted)] leading-snug">
              <span>Fuente: </span>
              <a href={platform.verification.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline text-[var(--color-text-muted)] hover:text-[var(--color-interactive)]">
                {platform.verification.officialSource}
              </a>
            </div>
          </footer>
        </article>
      ))
    }
  </div>

  <!-- PREGUNTAS FRECUENTES (Sin caja exterior anidando acordeones) -->
  <div class="pt-4 space-y-4">
    <div>
      <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] m-0">
        Preguntas frecuentes sobre plataformas de la UNLu
      </h3>
      <p class="text-sm text-[var(--color-text-muted)] mt-1">
        Respuestas directas para saber a qué sistema entrar en cada momento de tu cursada.
      </p>
    </div>

    <div class="space-y-3">
      {
        platformFaqs.map((faq, idx) => (
          <Accordion title={faq.question} badge={faq.highlightPlatform} open={idx === 0}>
            <p class="mb-2 text-sm">{faq.answer}</p>
            {faq.appNote && (
              <p class="text-xs sm:text-sm font-medium text-[var(--brand-700)] dark:text-[var(--brand-300)] mt-2 flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                <span>{faq.appNote}</span>
              </p>
            )}
            {faq.platformUrl && (
              <div class="pt-2">
                <a
                  href={faq.platformUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 py-1 text-xs sm:text-sm font-semibold text-[var(--color-interactive)] underline"
                >
                  <span>Ir al sitio oficial de {faq.highlightPlatform}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            )}
          </Accordion>
        ))
      }
    </div>
  </div>
</section>
