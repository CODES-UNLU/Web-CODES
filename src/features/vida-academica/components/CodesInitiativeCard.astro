---
import type { CodesInitiative } from '../data/academicData';
import Badge from '../../../components/ui/Badge.astro';

interface Props {
  initiative: CodesInitiative;
}

const { initiative } = Astro.props;
---

<article class="bg-[var(--color-surface)] border-2 border-[var(--brand-300)] dark:border-[var(--brand-700)] rounded-xl p-5 sm:p-6 shadow-xs" id={initiative.id}>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div>
      <span class="text-xs font-bold text-[var(--brand-700)] dark:text-[var(--brand-300)] uppercase tracking-wider block mb-1">
        Iniciativa impulsada por CODES
      </span>
      <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] m-0">
        {initiative.title}
      </h3>
    </div>
    <Badge variant={initiative.statusVariant}>{initiative.status}</Badge>
  </div>

  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
    {initiative.description}
  </p>

  <div class="mb-4 bg-[var(--brand-50)] dark:bg-[var(--brand-950)] p-4 rounded-lg border border-[var(--brand-200)] dark:border-[var(--brand-900)]">
    <h4 class="font-bold text-xs uppercase tracking-wider text-[var(--brand-800)] dark:text-[var(--brand-200)] mb-2">
      Objetivos de la gestión
    </h4>
    <ul class="space-y-1.5 list-disc pl-4 text-xs sm:text-sm text-[var(--color-text-main)]">
      {initiative.objectives.map((obj) => (
        <li>{obj}</li>
      ))}
    </ul>
  </div>

  <footer class="pt-3 border-t border-[var(--color-border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--color-text-muted)]">
    <div>
      <span class="font-semibold text-[var(--color-text-heading)]">Período: </span>
      <span>{initiative.period}</span>
    </div>
    <div>
      <span class="font-semibold text-[var(--color-text-heading)]">Contacto responsable: </span>
      <span>{initiative.responsibleContact}</span>
    </div>
  </footer>
</article>
