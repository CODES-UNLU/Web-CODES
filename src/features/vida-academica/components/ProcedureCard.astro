---
import type { UniversityProcedure } from '../data/academicData';
import Badge from '../../../components/ui/Badge.astro';

interface Props {
  procedure: UniversityProcedure;
}

const { procedure } = Astro.props;
---

<article class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 sm:p-6 shadow-xs transition-all hover:border-[var(--brand-400)]" id={procedure.id}>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] m-0">
      {procedure.title}
    </h3>
    <Badge variant="info">{procedure.category}</Badge>
  </div>

  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
    {procedure.description}
  </p>

  {
    procedure.statusNote && (
      <div class="mb-4 p-2.5 rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border-subtle)] text-xs text-[var(--color-text-muted)] flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-info)] shrink-0" aria-hidden="true" />
        <span>{procedure.statusNote}</span>
      </div>
    )
  }

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 text-xs sm:text-sm">
    <div class="bg-[var(--color-bg-subtle)] p-4 rounded-lg border border-[var(--color-border-subtle)]">
      <h4 class="font-bold text-[var(--color-text-heading)] mb-2 text-xs uppercase tracking-wider">
        Requisitos
      </h4>
      <ul class="space-y-1.5 list-disc pl-4 text-[var(--color-text-main)]">
        {procedure.requirements.map((req) => (
          <li>{req}</li>
        ))}
      </ul>
    </div>

    <div class="bg-[var(--color-bg-subtle)] p-4 rounded-lg border border-[var(--color-border-subtle)]">
      <h4 class="font-bold text-[var(--color-text-heading)] mb-2 text-xs uppercase tracking-wider">
        Paso a paso
      </h4>
      <ol class="space-y-1.5 list-none p-0 m-0 text-[var(--color-text-main)]">
        {procedure.steps.map((st) => (
          <li>{st}</li>
        ))}
      </ol>
    </div>
  </div>

  <footer class="pt-3 border-t border-[var(--color-border-subtle)] flex flex-wrap items-center justify-between gap-2 text-xs text-[var(--color-text-muted)]">
    <div>
      <span class="font-semibold text-[var(--color-text-heading)]">Canal oficial: </span>
      <span>{procedure.officialChannel}</span>
    </div>
  </footer>
</article>
