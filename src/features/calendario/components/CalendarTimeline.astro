---
import { calendarEvents, type CalendarEvent } from '../data/calendarEvents';
import Badge from '../../../components/ui/Badge.astro';

// Agrupamos los eventos por período
const periods = Array.from(new Set(calendarEvents.map((e) => e.period)));
---

<div class="space-y-8">
  {
    periods.map((period) => {
      const eventsInPeriod = calendarEvents.filter((e) => e.period === period);
      return (
        <section class="space-y-4">
          <div class="sticky top-16 z-20 py-2 bg-[var(--color-bg)]/90 backdrop-blur-sm border-b border-[var(--color-border-subtle)]">
            <h3 class="text-base sm:text-lg font-bold text-[var(--brand-700)] dark:text-[var(--brand-300)] flex items-center gap-2 m-0">
              <span class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--brand-500)]" aria-hidden="true" />
              <span>{period}</span>
            </h3>
          </div>

          <div class="relative pl-4 sm:pl-6 space-y-4 border-l-2 border-[var(--color-border)] ml-2">
            {eventsInPeriod.map((event) => (
              <article
                class="relative bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-4 sm:p-5 shadow-xs transition-all hover:border-[var(--brand-400)]"
                id={event.id}
              >
                <!-- Punto en la línea de tiempo -->
                <div
                  class="absolute -left-[25px] sm:-left-[33px] top-5 w-3.5 h-3.5 rounded-full bg-[var(--brand-500)] ring-4 ring-[var(--color-bg)]"
                  aria-hidden="true"
                />

                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-bold text-sm sm:text-base text-[var(--color-text-heading)]">
                      {event.title}
                    </span>
                    <Badge variant={event.categoryVariant}>{event.category}</Badge>
                  </div>
                  <div class="text-xs font-semibold px-2.5 py-1 rounded-md bg-[var(--color-bg-subtle)] text-[var(--color-text-main)] border border-[var(--color-border-subtle)] self-start sm:self-auto shrink-0">
                    {event.dateDisplay}
                  </div>
                </div>

                <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed mb-3">
                  {event.description}
                </p>

                <footer class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-[var(--color-border-subtle)] text-[11px] sm:text-xs">
                  <div class="flex items-center gap-1.5 text-[var(--color-text-muted)]">
                    <span class="font-medium text-[var(--color-text-heading)]">Fuente:</span>
                    <span>{event.sourceNote}</span>
                  </div>

                  <div>
                    {event.isConfirmed ? (
                      <span class="inline-flex items-center gap-1 text-[var(--color-success)] font-medium">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>Confirmada oficial</span>
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 text-[var(--color-warning)] font-medium">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <span>Provisoria · Sujeta a ratificación</span>
                      </span>
                    )}
                  </div>
                </footer>
              </article>
            ))}
          </div>
        </section>
      );
    })
  }
</div>
