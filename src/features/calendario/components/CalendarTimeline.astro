---
import { calendarEvents, CALENDAR_YEAR, type CalendarEvent } from '../data/calendarEvents';
import Badge from '../../../components/ui/Badge.astro';
import CalendarEventCard from './CalendarEventCard.astro';
import Button from '../../../components/ui/Button.astro';

const now = new Date();
const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

function getDaysDiff(fromIso: string, toIso: string): number {
  const fromMs = Date.parse(`${fromIso}T00:00:00Z`);
  const toMs = Date.parse(`${toIso}T00:00:00Z`);
  return Math.round((toMs - fromMs) / 86_400_000);
}

// Orden cronológico real
const sortedEvents = [...calendarEvents].sort((a, b) => a.startDate.localeCompare(b.startDate));

// Evento en curso o próximo en el año
const activeOrUpcomingEvent =
  sortedEvents.find((e) => e.endDate >= todayIso) ?? sortedEvents[sortedEvents.length - 1];

const isCurrentEvent =
  activeOrUpcomingEvent.startDate <= todayIso && todayIso <= activeOrUpcomingEvent.endDate;
const isFutureEvent = activeOrUpcomingEvent.startDate > todayIso;
const daysUntilNext = isFutureEvent ? getDaysDiff(todayIso, activeOrUpcomingEvent.startDate) : 0;

const highlightBadgeText = isCurrentEvent
  ? 'En curso'
  : isFutureEvent
    ? daysUntilNext === 1
      ? 'Próximo · Mañana'
      : `Próximo · Faltan ${daysUntilNext} días`
    : `Último hito ${CALENDAR_YEAR}`;

// Cada fecha se clasifica por separado: si ya terminó va a "fechas anteriores",
// aunque su período todavía tenga fechas vigentes (p. ej. el 2° cuatrimestre).
// El script del cliente repite esta clasificación con la fecha real del visitante,
// porque el sitio es estático y el build puede ser anterior a la visita.
const periods = Array.from(new Set(sortedEvents.map((e) => e.period)));

const isEventPast = (event: CalendarEvent) => event.endDate < todayIso;

const periodLabel = (period: CalendarEvent['period']) =>
  period.includes('2027') ? period : `${period} · ${CALENDAR_YEAR}`;

const groupBy = (past: boolean) =>
  periods.map((period) => ({
    period,
    events: sortedEvents.filter((e) => e.period === period && isEventPast(e) === past),
  }));

const upcomingGroups = groupBy(false);
const pastGroups = groupBy(true);
const pastCount = pastGroups.reduce((acc, g) => acc + g.events.length, 0);
---

<div class="space-y-8" data-calendar-root>
  <!-- Bloque destacado: Próximo hito o hito en curso -->
  <section
    id="next-calendar-highlight"
    class="bg-[var(--color-surface)] border-2 border-[var(--brand-400)] rounded-xl p-5 sm:p-6 shadow-sm space-y-4"
    aria-labelledby="next-calendar-heading"
  >
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="next-calendar-heading" class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] m-0">
        Próximo en el calendario {CALENDAR_YEAR}
      </h2>
      <Badge variant={isCurrentEvent ? 'success' : 'brand'} class="tabular-nums">
        <span data-highlight-status>{highlightBadgeText}</span>
      </Badge>
    </div>

    <div class="space-y-1.5">
      <p
        class="text-base sm:text-lg font-extrabold tabular-nums text-[var(--brand-700)] dark:text-[var(--brand-300)] m-0"
        data-highlight-date
      >
        {activeOrUpcomingEvent.dateDisplay}
      </p>
      <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] m-0" data-highlight-title>
        {activeOrUpcomingEvent.title}
      </h3>
      <p class="text-sm text-[var(--color-text-main)] leading-relaxed m-0" data-highlight-desc>
        {activeOrUpcomingEvent.description}
      </p>
    </div>

    <div class="pt-3 border-t border-[var(--color-border-subtle)] flex flex-wrap items-center gap-3">
      <Button
        href="https://saweb.unlu.edu.ar/academica/estudiante-index.php"
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="sm"
      >
        <span>Ir a SAWEB (Cohortes previas a 2027)</span>
        <span aria-hidden="true">↗</span>
      </Button>
      <Button
        href="https://g3w3.unlu.edu.ar/"
        target="_blank"
        rel="noopener noreferrer"
        variant="outline"
        size="sm"
      >
        <span>Ir a Gestión de Estudiantes (2027+)</span>
        <span aria-hidden="true">↗</span>
      </Button>
    </div>
  </section>

  <!-- Períodos actuales y próximos: solo las fechas que todavía no terminaron -->
  <div class="flex flex-col gap-8" data-upcoming-root>
    {
      upcomingGroups.map((group) => (
        <section class="space-y-4" data-period-section={group.period} hidden={group.events.length === 0}>
          <div class="sticky top-16 z-20 py-2 bg-[var(--color-bg)]/95 backdrop-blur-sm border-b border-[var(--color-border-subtle)]">
            <h2 class="text-lg sm:text-xl font-bold text-[var(--brand-700)] dark:text-[var(--brand-300)] flex items-center gap-2 m-0">
              <span class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--brand-500)]" aria-hidden="true" />
              <span>{periodLabel(group.period)}</span>
            </h2>
          </div>

          <div class="relative pl-4 sm:pl-6 space-y-4 border-l-2 border-[var(--color-border)] ml-2" data-period-events>
            {group.events.map((event) => <CalendarEventCard event={event} isPast={false} />)}
          </div>
        </section>
      ))
    }
  </div>

  <!-- Fechas ya pasadas del año, agrupadas por período y colapsadas por defecto -->
  <details
    id="past-periods-details"
    class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 sm:p-5"
    hidden={pastCount === 0}
  >
    <summary class="flex items-center justify-between gap-3 cursor-pointer list-none select-none font-semibold text-sm sm:text-base text-[var(--color-text-heading)] min-h-[40px]">
      <span>
        Ver fechas anteriores de {CALENDAR_YEAR} (<span data-past-count>{pastCount}</span>)
      </span>
      <span class="shrink-0 text-[var(--color-text-muted)] transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </span>
    </summary>

    <div class="pt-6 flex flex-col gap-8" data-past-root>
      {
        pastGroups.map((group) => (
          <section class="space-y-4" data-period-section={group.period} hidden={group.events.length === 0}>
            <div class="py-1.5 border-b border-[var(--color-border)]">
              <h2 class="text-base sm:text-lg font-bold text-[var(--color-text-heading)] m-0">
                {periodLabel(group.period)}
              </h2>
            </div>

            <div class="relative pl-4 sm:pl-6 space-y-4 border-l-2 border-[var(--color-border)] ml-2" data-period-events>
              {group.events.map((event) => <CalendarEventCard event={event} isPast={true} />)}
            </div>
          </section>
        ))
      }
    </div>
  </details>
</div>

<script is:inline>
  (() => {
    const pastDetails = document.getElementById('past-periods-details');
    const statusEl = document.querySelector('[data-highlight-status]');
    const dateEl = document.querySelector('[data-highlight-date]');
    const titleEl = document.querySelector('[data-highlight-title]');
    const descEl = document.querySelector('[data-highlight-desc]');

    const now = new Date();
    const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

    // El HTML se genera en el build: movemos a "fechas anteriores" cada fecha que
    // haya terminado desde entonces, respetando su período y el orden cronológico.
    const upcomingRoot = document.querySelector('[data-upcoming-root]');
    const pastRoot = document.querySelector('[data-past-root]');
    const countEl = document.querySelector('[data-past-count]');

    if (upcomingRoot && pastRoot && pastDetails) {
      upcomingRoot.querySelectorAll('[data-calendar-event]').forEach((card) => {
        if ((card.getAttribute('data-end-date') || '') >= todayIso) return;
        const period = card.closest('[data-period-section]')?.getAttribute('data-period-section');
        const pastSection = Array.from(pastRoot.querySelectorAll('[data-period-section]')).find(
          (section) => section.getAttribute('data-period-section') === period
        );
        const list = pastSection?.querySelector('[data-period-events]');
        if (!list) return;
        const start = card.getAttribute('data-start-date') || '';
        const next = Array.from(list.children).find(
          (el) => (el.getAttribute('data-start-date') || '') > start
        );
        card.setAttribute('data-past', '');
        list.insertBefore(card, next || null);
      });

      document.querySelectorAll('[data-period-section]').forEach((section) => {
        section.hidden = !section.querySelector('[data-calendar-event]');
      });

      const pastTotal = pastRoot.querySelectorAll('[data-calendar-event]').length;
      pastDetails.hidden = pastTotal === 0;
      if (countEl) countEl.textContent = String(pastTotal);
    }

    // Actualiza el bloque destacado según la fecha actual real del navegador
    const articles = Array.from(document.querySelectorAll('[data-start-date]')).sort((a, b) =>
      (a.getAttribute('data-start-date') || '').localeCompare(b.getAttribute('data-start-date') || '')
    );

    if (articles.length > 0 && statusEl && dateEl && titleEl && descEl) {
      const target =
        articles.find((el) => (el.getAttribute('data-end-date') || '') >= todayIso) ||
        articles[articles.length - 1];

      const start = target.getAttribute('data-start-date') || '';
      const end = target.getAttribute('data-end-date') || '';
      dateEl.textContent = target.getAttribute('data-event-date') || '';
      titleEl.textContent = target.getAttribute('data-event-title') || '';
      descEl.textContent = target.getAttribute('data-event-desc') || '';

      if (start <= todayIso && todayIso <= end) {
        statusEl.textContent = 'En curso';
      } else if (start > todayIso) {
        const diff = Math.round(
          (Date.parse(`${start}T00:00:00Z`) - Date.parse(`${todayIso}T00:00:00Z`)) / 86400000
        );
        statusEl.textContent = diff === 1 ? 'Próximo · Mañana' : `Próximo · Faltan ${diff} días`;
      } else {
        statusEl.textContent = 'Último hito del ciclo';
      }
    }

    // Si el usuario entra con un hash hacia un evento que quedó colapsado, lo abrimos y scrolleamos
    function openHashIfCollapsed() {
      if (!pastDetails || !window.location.hash) return;
      const targetId = window.location.hash.slice(1);
      const targetEl = document.getElementById(targetId);
      if (targetEl && pastDetails.contains(targetEl)) {
        pastDetails.open = true;
        requestAnimationFrame(() => {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    }

    openHashIfCollapsed();
    window.addEventListener('hashchange', openHashIfCollapsed);
  })();
</script>
