---
import Button from '../../../components/ui/Button.astro';

interface Props {
  formUrl?: string;
  title?: string;
  description?: string;
  alternativeContactEmail?: string;
}

const {
  formUrl,
  title = 'Cómo sumarte a los grupos de estudio',
  description = 'Los enlaces a los grupos moderados por materia se comparten en los canales oficiales de CODES y en la mesita presencial.',
  alternativeContactEmail = 'contacto@codesunlu.com.ar',
} = Astro.props;

const hasValidUrl = Boolean(formUrl && formUrl.trim().startsWith('http'));
---

<div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 sm:p-8 shadow-xs space-y-6">
  <div class="max-w-2xl space-y-2">
    <h3 class="text-xl sm:text-2xl font-bold text-[var(--color-text-heading)] m-0">
      {title}
    </h3>
    <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed m-0">
      {description}
    </p>
  </div>

  {
    hasValidUrl ? (
      <div class="space-y-4">
        <!-- Contenedor responsive del iframe: muestra un placeholder con pulso hasta que carga -->
        <div class="form-skeleton relative w-full overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)]">
          <iframe
            src={formUrl}
            title={title}
            class="w-full min-h-[550px] border-0"
            loading="lazy"
            onload="this.parentElement.classList.add('is-loaded')"
          >
            Cargando formulario...
          </iframe>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-2 text-xs text-[var(--color-text-muted)]">
          <span>¿Tenés problemas para visualizar el formulario integrado?</span>
          <Button
            href={formUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
            size="sm"
          >
            <span>Abrir formulario en nueva pestaña</span>
            <span aria-hidden="true">↗</span>
          </Button>
        </div>
      </div>
    ) : (
      <div class="space-y-6">
        <p class="text-sm text-[var(--color-text-main)] leading-relaxed m-0">
          CODES nunca te solicita contraseñas de plataformas universitarias (SAWEB, Sistema de Gestión de Estudiantes ni Educativa), certificados ni datos personales sensibles para ingresar a un grupo.
        </p>

        <div class="pt-5 border-t border-[var(--color-border-subtle)] grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-1.5">
            <h4 class="text-sm font-bold text-[var(--color-text-heading)] m-0">
              Mesita presencial · Sede Central Luján
            </h4>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed m-0">
              Sector de Pabellones / Hall académico junto a las aulas de Sistemas (Cruce de Rutas 5 y 7). Lunes a viernes durante el cuatrimestre en cambios de turno (mañana, tarde y vespertino).
            </p>
          </div>

          <div class="space-y-1.5">
            <h4 class="text-sm font-bold text-[var(--color-text-heading)] m-0">
              Centro Regional San Miguel
            </h4>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed m-0">
              Fariña 2180. Presencia en días de cursada de primeros años y coordinación permanente a través de los canales digitales del centro.
            </p>
          </div>
        </div>

        <div class="pt-5 border-t border-[var(--color-border-subtle)] flex flex-wrap items-center gap-3">
          <Button
            href="https://link.codesunlu.com.ar/"
            target="_blank"
            rel="noopener noreferrer"
            variant="primary"
            size="md"
          >
            <span>Abrir los canales de CODES</span>
            <span aria-hidden="true">↗</span>
          </Button>

          {
            alternativeContactEmail && (
              <Button
                href={`mailto:${alternativeContactEmail}`}
                variant="outline"
                size="md"
              >
                <span>Escribir a {alternativeContactEmail}</span>
              </Button>
            )
          }
        </div>
      </div>
    )
  }
</div>
