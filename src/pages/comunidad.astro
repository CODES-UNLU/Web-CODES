---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Callout from '../components/ui/Callout.astro';
import Button from '../components/ui/Button.astro';
import GoogleFormEmbed from '../features/comunidad/components/GoogleFormEmbed.astro';
import {
  communityChannels,
  codeOfConductRules,
} from '../features/comunidad/data/channelsData';

const breadcrumbs = [{ label: 'Comunidad', href: '/comunidad' }];
---

<PageLayout
  title="Comunidad Estudiantil y Canales de Contacto | CODES UNLu"
  description="Canales oficiales, grupos de estudio de WhatsApp por materia, mesita presencial y espacios de consulta para estudiantes de Sistemas de la Universidad Nacional de Luján."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-12">
    <div>
      <Breadcrumbs items={[{ label: 'Comunidad' }]} />

      <SectionHeading
        level={1}
        title="Comunidad"
        subtitle="Conectate con otros estudiantes de Sistemas, encontrá grupos de estudio por materia y acercate a la mesita de CODES."
      />

      <Callout variant="brand" title="Estudiar en comunidad">
        <p>
          Los grupos de CODES son espacios solidarios autogestionados por estudiantes. Acá podés consultar dudas de trabajos prácticos, conseguir apuntes y coordinar grupos de estudio para parciales y finales.
        </p>
      </Callout>
    </div>

    <!-- CANALES VERIFICADOS -->
    <section class="space-y-4">
      <SectionHeading
        level={2}
        title="Canales de difusión y estudio"
        subtitle="Cómo funciona cada espacio de comunicación mantenido por el centro de estudiantes."
      />

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          communityChannels.map((channel) => (
            <article class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5 shadow-xs flex flex-col justify-between gap-4">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2 text-xs">
                  <span class="font-medium text-[var(--color-text-muted)]">{channel.category}</span>
                  <span class="font-semibold text-[var(--brand-700)] dark:text-[var(--brand-300)]">{channel.status}</span>
                </div>
                <h3 class="text-base font-bold text-[var(--color-text-heading)] mb-2">
                  {channel.title}
                </h3>
                <p class="text-sm text-[var(--color-text-muted)] leading-relaxed m-0">
                  {channel.description}
                </p>
              </div>

              {channel.link && (
                <div class="pt-3 border-t border-[var(--color-border-subtle)]">
                  <Button
                    href={channel.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    variant="outline"
                    size="sm"
                    class="w-full text-center min-h-[44px]"
                  >
                    <span>{channel.linkLabel || 'Abrir canal'}</span>
                    <span aria-hidden="true">↗</span>
                  </Button>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <!-- INGRESO Y MESITA PRESENCIAL -->
    <section class="space-y-4">
      <SectionHeading
        level={2}
        title="Dónde encontrarnos y cómo sumarte"
        subtitle="Acceso a los grupos por materia, ubicación de la mesita presencial y contacto directo."
      />

      <GoogleFormEmbed
        title="Cómo pedir los enlaces de los grupos por materia"
        description="Para mantener los grupos de WhatsApp libres de spam comercial y cuentas falsas, el acceso se comparte directamente en nuestros canales y en la mesita presencial."
        alternativeContactEmail="contacto@codesunlu.com.ar"
      />
    </section>

    <!-- NORMAS DE CONVIVENCIA -->
    <section class="bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-xl p-6 sm:p-8 space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] flex items-center gap-2 m-0">
        <svg class="w-5 h-5 text-[var(--brand-600)] dark:text-[var(--brand-400)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>Pautas de convivencia en los grupos</span>
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed m-0">
        El ingreso a cualquier grupo de CODES implica el compromiso de cuidar el espacio de estudio de todos los compañeros:
      </p>
      <ul class="space-y-2 list-disc pl-5 text-sm text-[var(--color-text-main)] leading-relaxed">
        {codeOfConductRules.map((rule) => <li>{rule}</li>)}
      </ul>
    </section>
  </div>
</PageLayout>
