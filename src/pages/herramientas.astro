---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Callout from '../components/ui/Callout.astro';
import ToolCard from '../features/herramientas/components/ToolCard.astro';
import { toolsData, toolCategories } from '../features/herramientas/data/toolsData';
import { withBase } from '../lib/paths';

const getTool = (id: string) => toolsData.find((t) => t.id === id);
const ghPages = getTool('github-pages');
const netlify = getTool('netlify');
const vercel = getTool('vercel');
const render = getTool('render');
const railway = getTool('railway');
const supabase = getTool('supabase');

const initialCategory = toolCategories.find((c) => c.id === 'empezar') ?? toolCategories[0];
const initialCount = toolsData.filter((t) => t.categories.includes('empezar')).length;

const categoryMetaMap = Object.fromEntries([
  ...toolCategories.map((c) => [
    c.id,
    {
      name: c.name,
      description: c.description,
      contextAdvice: c.contextAdvice ?? '',
      count: toolsData.filter((t) => t.categories.includes(c.id)).length,
    },
  ]),
  [
    'todas',
    {
      name: 'Todas las herramientas',
      description:
        'Catálogo completo sin duplicados: editores, control de versiones, bases de datos, clientes HTTP, diagramas y servicios de despliegue.',
      contextAdvice:
        'Usá el buscador de arriba para filtrar al instante por nombre, lenguaje o tarea.',
      count: toolsData.length,
    },
  ],
]);

const breadcrumbs = [{ label: 'Herramientas', href: '/herramientas' }];
---

<PageLayout
  title="Herramientas y Recursos de Desarrollo para Sistemas UNLu | CODES"
  description="Catálogo de herramientas, utilidades de desarrollo, hosting gratuito y software recomendado para estudiantes de Sistemas de la UNLu."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">
    <!-- Encabezado y migas de pan -->
    <div>
      <Breadcrumbs items={[{ label: 'Herramientas' }]} />

      <SectionHeading
        level={1}
        title="Herramientas"
        subtitle="Guía orientativa de programas, plataformas y servicios gratuitos o libres para tus cursadas y proyectos."
      />

      <div class="pt-2">
        <Callout variant="info" title="Cómo utilizar este catálogo">
          <p>
            No necesitás instalar todo de golpe: cada ficha explica <strong>para qué sirve</strong>, <strong>en qué situación te ayuda</strong> y <strong>para qué perfil está pensada</strong>. Todas las opciones tienen licencias libres o planes gratuitos para estudiantes.
          </p>
        </Callout>
      </div>
    </div>

    <!-- 1. GUÍA DESPLEGABLE DE DESPLIEGUE (Sin tarjetas anidadas) -->
    <details
      class="group bg-[var(--color-surface)] border-2 border-[var(--brand-300)] dark:border-[var(--brand-700)] rounded-2xl p-4 sm:p-6 transition-all duration-200"
      id="guia-despliegue"
    >
      <summary class="group/summary flex items-start sm:items-center justify-between gap-4 cursor-pointer select-none list-none focus-visible:outline-2 focus-visible:outline-[var(--brand-500)] rounded-lg">
        <div class="space-y-1">
          <h2 class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] group-hover/summary:text-[var(--brand-700)] dark:group-hover/summary:text-[var(--brand-300)] transition-colors m-0">
            ¿Querés compartir tu proyecto y no sabés cómo publicarlo?
          </h2>
          <p class="text-sm text-[var(--color-text-muted)] m-0">
            Seleccioná para desplegar una guía rápida según lo que construiste: páginas simples, apps interactivas, servidores backend o bases de datos.
          </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <span class="hidden sm:inline text-xs font-semibold text-[var(--color-interactive)] group-open:hidden">
            Desplegar guía
          </span>
          <div
            class="w-9 h-9 rounded-full bg-[var(--color-bg-subtle)] border border-[var(--brand-300)] dark:border-[var(--brand-700)] flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform duration-200 text-[var(--brand-700)] dark:text-[var(--brand-300)]"
            aria-hidden="true"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </summary>

      <div class="pt-5 mt-5 border-t border-[var(--color-border)] space-y-6 text-sm cursor-default">
        <p class="text-[var(--color-text-main)] leading-relaxed m-0">
          Publicar un proyecto no requiere memorizar nombres de servidores: alcanza con identificar <strong>qué hace tu código</strong> y <strong>dónde se ejecuta</strong>. Estas son las cuatro situaciones más habituales en la facultad:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Caso 1 -->
          <section class="pt-4 border-t border-[var(--color-border-subtle)] flex flex-col justify-between gap-4">
            <div class="space-y-2">
              <h3 class="text-base font-bold text-[var(--color-text-heading)] m-0">
                1. Página con información, imágenes y enlaces
              </h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)] m-0">
                <strong>Qué proyecto es:</strong> Web de un trabajo práctico, portafolio personal o apuntes hechos en HTML, CSS y JavaScript (o generados con Astro/Vite).
              </p>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)] m-0">
                <strong>Qué necesita:</strong> Un alojamiento estático que sirva tus archivos directo al navegador. Comprobá que las rutas sean relativas y que el repo sea público si usás GitHub Pages gratis.
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              {ghPages && (
                <a
                  href={ghPages.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[var(--color-interactive)] font-semibold text-xs no-underline hover:border-[var(--brand-500)] transition-colors"
                >
                  <img src={withBase(ghPages.logo)} alt="" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
                  <span>{ghPages.name}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              {netlify && (
                <a
                  href={netlify.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[var(--color-interactive)] font-semibold text-xs no-underline hover:border-[var(--brand-500)] transition-colors"
                >
                  <img src={withBase(netlify.logo)} alt="" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
                  <span>{netlify.name}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </section>

          <!-- Caso 2 -->
          <section class="pt-4 border-t border-[var(--color-border-subtle)] flex flex-col justify-between gap-4">
            <div class="space-y-2">
              <h3 class="text-base font-bold text-[var(--color-text-heading)] m-0">
                2. Aplicación web interactiva en el navegador
              </h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)] m-0">
                <strong>Qué proyecto es:</strong> Una app hecha con React, Vue, Svelte o JavaScript moderno que corre del lado del usuario (calculadoras, tableros, juegos).
              </p>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)] m-0">
                <strong>Qué necesita:</strong> Una plataforma que compile tu repo en cada push. Una app en React sin datos compartidos <em>no necesita un servidor backend</em>.
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              {vercel && (
                <a
                  href={vercel.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[var(--color-interactive)] font-semibold text-xs no-underline hover:border-[var(--brand-500)] transition-colors"
                >
                  <img src={withBase(vercel.logo)} alt="" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
                  <span>{vercel.name}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              {netlify && (
                <a
                  href={netlify.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[var(--color-interactive)] font-semibold text-xs no-underline hover:border-[var(--brand-500)] transition-colors"
                >
                  <img src={withBase(netlify.logo)} alt="" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
                  <span>{netlify.name}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </section>

          <!-- Caso 3 -->
          <section class="pt-4 border-t border-[var(--color-border-subtle)] flex flex-col justify-between gap-4">
            <div class="space-y-2">
              <h3 class="text-base font-bold text-[var(--color-text-heading)] m-0">
                3. API o programa que corre en un servidor
              </h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)] m-0">
                <strong>Qué proyecto es:</strong> Una API REST o servidor en Node.js/Express, Python/FastAPI/Flask, Java/Spring o Docker escuchando peticiones.
              </p>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)] m-0">
                <strong>Qué necesita:</strong> Hosting de backend con HTTPS. En el plan gratuito de Render el servicio se suspende tras 15 minutos sin tráfico y tarda unos 30–50 segundos en despertar.
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              {render && (
                <a
                  href={render.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[var(--color-interactive)] font-semibold text-xs no-underline hover:border-[var(--brand-500)] transition-colors"
                >
                  <img src={withBase(render.logo)} alt="" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
                  <span>{render.name}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              {railway && (
                <a
                  href={railway.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[var(--color-interactive)] font-semibold text-xs no-underline hover:border-[var(--brand-500)] transition-colors"
                >
                  <img src={withBase(railway.logo)} alt="" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
                  <span>{railway.name}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </section>

          <!-- Caso 4 -->
          <section class="pt-4 border-t border-[var(--color-border-subtle)] flex flex-col justify-between gap-4">
            <div class="space-y-2">
              <h3 class="text-base font-bold text-[var(--color-text-heading)] m-0">
                4. Aplicación que guarda datos entre sesiones
              </h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)] m-0">
                <strong>Qué proyecto es:</strong> Sistemas con registro de usuarios, publicaciones o inventario donde los datos no pueden perderse al cerrar la pestaña.
              </p>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)] m-0">
                <strong>Qué necesita:</strong> Una base de datos PostgreSQL o BaaS en la nube. Una base de datos <em>no reemplaza</em> un backend si tenés lógica propia, y podés combinar Vercel + Render + Supabase.
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              {supabase && (
                <a
                  href={supabase.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[var(--color-interactive)] font-semibold text-xs no-underline hover:border-[var(--brand-500)] transition-colors"
                >
                  <img src={withBase(supabase.logo)} alt="" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
                  <span>{supabase.name}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              {render && (
                <a
                  href="https://render.com/docs/databases"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[38px] rounded-lg bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[var(--color-interactive)] font-semibold text-xs no-underline hover:border-[var(--brand-500)] transition-colors"
                >
                  <img src={withBase(render.logo)} alt="" class="w-3.5 h-3.5 object-contain" width="14" height="14" />
                  <span>Render PostgreSQL</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </section>
        </div>
      </div>
    </details>

    <!-- 2. NAVEGACIÓN Y FILTRADO DEL CATÁLOGO -->
    <section
      id="catalogo-herramientas"
      class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-4 sm:p-6 shadow-xs space-y-4"
      aria-label="Controles del catálogo de herramientas"
    >
      <!-- Anclas compatibles para enlaces directos por categoría (#cat-*) -->
      {toolCategories.map((cat) => <span id={`cat-${cat.id}`} class="sr-only" aria-hidden="true" />)}

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] m-0">
            Catálogo de herramientas
          </h2>
          <p class="text-sm text-[var(--color-text-muted)] m-0 mt-0.5">
            Filtrá por etapa o buscá por nombre, lenguaje o tarea en todo el catálogo.
          </p>
        </div>

        <!-- Buscador rápido en vivo -->
        <div class="w-full sm:w-80 relative">
          <label for="tools-search-input" class="sr-only">Buscar herramientas por nombre, tecnología o caso de uso</label>
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[var(--color-text-muted)]" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="search"
            id="tools-search-input"
            class="w-full pl-9 pr-10 py-2.5 min-h-[42px] bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-lg text-sm text-[var(--color-text-heading)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:border-[var(--brand-500)] focus:ring-1 focus:ring-[var(--brand-500)] transition-colors"
            placeholder="Buscar en las 34 herramientas..."
            autocomplete="off"
          />
          <button
            type="button"
            id="tools-search-clear"
            class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] min-w-[36px] justify-center cursor-pointer hidden"
            aria-label="Limpiar búsqueda de herramientas"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Controles de categorías con altura táctil >= 40px -->
      <nav class="flex flex-wrap items-center gap-2 pt-3 border-t border-[var(--color-border-subtle)]" aria-label="Filtro de categorías de herramientas">
        {
          toolCategories.map((cat) => {
            const isInitial = cat.id === 'empezar';
            const count = toolsData.filter((t) => t.categories.includes(cat.id)).length;
            return (
              <button
                type="button"
                class={`category-tab pressable min-h-[40px] px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all border cursor-pointer ${
                  isInitial
                    ? 'active bg-[var(--brand-50)] text-[var(--brand-800)] dark:bg-[var(--brand-950)] dark:text-[var(--brand-200)] border-[var(--brand-400)] dark:border-[var(--brand-700)] shadow-2xs'
                    : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-heading)] hover:bg-[var(--color-surface-hover)] border-[var(--color-border)]'
                }`}
                data-category={cat.id}
                aria-pressed={isInitial ? 'true' : 'false'}
              >
                <span>{cat.name}</span>{' '}
                <span class="font-normal tabular-nums">({count})</span>
              </button>
            );
          })
        }
        <button
          type="button"
          class="category-tab pressable min-h-[40px] px-3.5 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all text-[var(--color-text-muted)] hover:text-[var(--color-text-heading)] hover:bg-[var(--color-surface-hover)] border border-[var(--color-border)] cursor-pointer"
          data-category="todas"
          aria-pressed="false"
        >
          Ver todas (<span class="tabular-nums">{toolsData.length}</span>)
        </button>
      </nav>

      <!-- Mensaje dinámico de conteo y estado de filtros -->
      <div id="tools-filter-status" class="text-xs sm:text-sm font-medium text-[var(--color-text-muted)] pt-1" role="status" aria-live="polite">
        Mostrando <span id="tools-visible-count" class="tabular-nums">{initialCount}</span> herramientas en <strong id="tools-category-name" class="text-[var(--color-text-heading)]">{initialCategory.name}</strong>.
      </div>
    </section>

    <!-- 3. CABECERA DE CATEGORÍA ACTIVA + GRILLA ÚNICA SIN DUPLICADOS (34 herramientas) -->
    <div id="catalog-container" class="space-y-6 min-h-[400px]">
      <!-- Cabecera explicativa de la categoría o búsqueda actual -->
      <div
        id="active-category-banner"
        class="p-4 sm:p-5 rounded-xl bg-[var(--color-bg-subtle)] border border-[var(--color-border)] space-y-2"
      >
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
          <h3 id="banner-cat-title" class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] tracking-tight m-0">
            {initialCategory.name}
          </h3>
          <span id="banner-cat-count" class="text-xs font-semibold text-[var(--brand-700)] dark:text-[var(--brand-300)] tabular-nums">
            {initialCount} herramientas recomendadas
          </span>
        </div>
        <p id="banner-cat-desc" class="text-sm text-[var(--color-text-muted)] leading-relaxed m-0">
          {initialCategory.description}
        </p>
        <p id="banner-cat-advice-wrap" class="text-xs sm:text-sm text-[var(--brand-800)] dark:text-[var(--brand-200)] pt-1 m-0 flex items-start gap-2">
          <svg class="w-4 h-4 shrink-0 mt-0.5 text-[var(--brand-600)] dark:text-[var(--brand-400)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          <span id="banner-cat-advice">{initialCategory.contextAdvice}</span>
        </p>
      </div>

      <!-- Grilla única con las 34 herramientas sin duplicar IDs -->
      <div id="tools-catalog-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {toolsData.map((tool) => <ToolCard tool={tool} />)}
      </div>

      <!-- Mensaje útil cuando ninguna herramienta coincide con la búsqueda -->
      <div id="tools-empty-message" class="hidden text-center py-12 px-4 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] space-y-3">
        <div class="w-12 h-12 rounded-full bg-[var(--color-bg-subtle)] text-[var(--color-text-muted)] flex items-center justify-center mx-auto" aria-hidden="true">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-[var(--color-text-heading)]">
          No encontramos herramientas con ese término
        </h3>
        <p class="text-sm text-[var(--color-text-muted)] max-w-md mx-auto leading-relaxed">
          Probá buscando por lenguaje o función, como{' '}
          <button type="button" class="empty-suggestion text-[var(--color-interactive)] underline cursor-pointer">Git</button>,{' '}
          <button type="button" class="empty-suggestion text-[var(--color-interactive)] underline cursor-pointer">Python</button>,{' '}
          <button type="button" class="empty-suggestion text-[var(--color-interactive)] underline cursor-pointer">PostgreSQL</button>,{' '}
          <button type="button" class="empty-suggestion text-[var(--color-interactive)] underline cursor-pointer">Docker</button> o{' '}
          <button type="button" class="empty-suggestion text-[var(--color-interactive)] underline cursor-pointer">Vercel</button>.
        </p>
      </div>
    </div>

    <!-- Fallback accesible sin JavaScript -->
    <noscript>
      <style>
        .hidden-by-filter {
          display: flex !important;
        }
      </style>
      <div class="p-4 rounded-xl bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-sm text-[var(--color-text-muted)] mt-6">
        <p class="m-0">
          Estás navegando con JavaScript desactivado: se muestran las 34 herramientas del catálogo completas arriba.
        </p>
      </div>
    </noscript>

    <!-- 4. SECCIÓN COMUNITARIA -->
    <section class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-6 sm:p-8 text-center space-y-3">
      <h2 class="text-lg sm:text-xl font-bold text-[var(--color-text-heading)] m-0">
        ¿Conocés otra herramienta útil para la comunidad?
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] max-w-lg mx-auto leading-relaxed">
        El banco de herramientas se actualiza periódicamente a partir de las necesidades de las materias y las recomendaciones de estudiantes avanzados de CODES.
      </p>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://link.codesunlu.com.ar/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 py-2 text-sm font-semibold text-[var(--color-interactive)] underline"
        >
          <span>Sugerir herramienta en los canales de CODES</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href="mailto:contacto@codesunlu.com.ar"
          class="inline-flex items-center gap-1.5 py-2 text-sm font-semibold text-[var(--color-interactive)] underline"
        >
          <span>contacto@codesunlu.com.ar</span>
        </a>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .hidden-by-filter {
    display: none;
  }
</style>

<script is:inline define:vars={{ categoryMetaMap }}>
  (() => {
    const searchInput = document.getElementById('tools-search-input');
    const clearBtn = document.getElementById('tools-search-clear');
    const tabs = Array.from(document.querySelectorAll('.category-tab'));
    const cards = Array.from(document.querySelectorAll('#tools-catalog-grid .tool-card'));
    const emptyMsg = document.getElementById('tools-empty-message');
    const filterStatus = document.getElementById('tools-filter-status');
    const visibleCountEl = document.getElementById('tools-visible-count');
    const categoryNameEl = document.getElementById('tools-category-name');
    const emptySuggestions = document.querySelectorAll('.empty-suggestion');
    const banner = document.getElementById('active-category-banner');
    const bannerTitle = document.getElementById('banner-cat-title');
    const bannerCount = document.getElementById('banner-cat-count');
    const bannerDesc = document.getElementById('banner-cat-desc');
    const bannerAdviceWrap = document.getElementById('banner-cat-advice-wrap');
    const bannerAdvice = document.getElementById('banner-cat-advice');
    const deployGuide = document.getElementById('guia-despliegue');
    const catalogSection = document.getElementById('catalogo-herramientas');

    if (!tabs.length || !cards.length) return;

    const validCategories = Object.keys(categoryMetaMap);
    let activeCategory = 'empezar';
    let searchQuery = '';

    function normalize(text) {
      return (text || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function syncTabStyles() {
      tabs.forEach((t) => {
        const isCurrent = t.getAttribute('data-category') === activeCategory && !searchQuery.trim();
        t.classList.toggle('active', isCurrent);
        t.classList.toggle('bg-[var(--brand-50)]', isCurrent);
        t.classList.toggle('text-[var(--brand-800)]', isCurrent);
        t.classList.toggle('dark:bg-[var(--brand-950)]', isCurrent);
        t.classList.toggle('dark:text-[var(--brand-200)]', isCurrent);
        t.classList.toggle('border-[var(--brand-400)]', isCurrent);
        t.classList.toggle('dark:border-[var(--brand-700)]', isCurrent);
        t.classList.toggle('shadow-2xs', isCurrent);
        t.classList.toggle('text-[var(--color-text-muted)]', !isCurrent);
        t.classList.toggle('border-[var(--color-border)]', !isCurrent);
        t.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
      });
    }

    function syncUrl() {
      try {
        const url = new URL(window.location.href);
        if (searchQuery.trim()) {
          url.searchParams.set('q', searchQuery.trim());
          url.searchParams.delete('cat');
        } else {
          url.searchParams.delete('q');
          if (activeCategory === 'empezar') {
            url.searchParams.delete('cat');
          } else {
            url.searchParams.set('cat', activeCategory);
          }
        }
        window.history.replaceState(null, '', url.pathname + url.search + url.hash);
      } catch (e) {
        // Fallback seguro si replaceState no está disponible
      }
    }

    function updateView(options = { syncHistory: false }) {
      const q = normalize(searchQuery.trim());
      const isSearching = q.length > 0;
      let totalVisible = 0;

      cards.forEach((card) => {
        const cats = (card.getAttribute('data-categories') || '').split(',');
        const name = normalize(card.getAttribute('data-name') || '');
        const role = normalize(card.getAttribute('data-role') || '');
        const text = normalize(card.textContent || '');

        let visible = false;
        if (isSearching) {
          visible = name.includes(q) || role.includes(q) || text.includes(q);
        } else {
          visible = activeCategory === 'todas' || cats.includes(activeCategory);
        }

        if (visible) {
          card.classList.remove('hidden-by-filter');
          totalVisible++;
        } else {
          card.classList.add('hidden-by-filter');
        }
      });

      syncTabStyles();

      if (clearBtn) {
        clearBtn.classList.toggle('hidden', !isSearching);
      }

      if (emptyMsg) {
        emptyMsg.classList.toggle('hidden', totalVisible > 0);
      }

      if (banner) {
        if (isSearching) {
          banner.classList.add('hidden');
        } else {
          banner.classList.remove('hidden');
          const meta = categoryMetaMap[activeCategory] || categoryMetaMap.todas;
          if (bannerTitle) bannerTitle.textContent = meta.name;
          if (bannerCount) bannerCount.textContent = `${totalVisible} herramientas recomendadas`;
          if (bannerDesc) bannerDesc.textContent = meta.description;
          if (bannerAdviceWrap && bannerAdvice) {
            if (meta.contextAdvice) {
              bannerAdviceWrap.classList.remove('hidden');
              bannerAdvice.textContent = meta.contextAdvice;
            } else {
              bannerAdviceWrap.classList.add('hidden');
            }
          }
        }
      }

      if (filterStatus && visibleCountEl && categoryNameEl) {
        visibleCountEl.textContent = String(totalVisible);
        if (isSearching) {
          categoryNameEl.textContent = `búsqueda: "${searchQuery.trim()}" (en todo el catálogo)`;
        } else {
          const meta = categoryMetaMap[activeCategory] || categoryMetaMap.todas;
          categoryNameEl.textContent = meta.name;
        }
      }

      if (options.syncHistory) {
        syncUrl();
      }
    }

    function applyStateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const urlCat = params.get('cat');
      const urlQ = params.get('q');
      const hash = window.location.hash;

      if (urlCat && validCategories.includes(urlCat)) {
        activeCategory = urlCat;
      }

      if (urlQ) {
        searchQuery = urlQ;
        if (searchInput) searchInput.value = urlQ;
      }

      if (hash === '#guia-despliegue' && deployGuide) {
        deployGuide.open = true;
      } else if (hash.startsWith('#cat-')) {
        const hashCat = hash.replace('#cat-', '');
        if (validCategories.includes(hashCat)) {
          activeCategory = hashCat;
          searchQuery = '';
          if (searchInput) searchInput.value = '';
        }
      } else if (hash.startsWith('#herramienta-')) {
        const targetCard = document.getElementById(hash.slice(1));
        if (targetCard) {
          const cardCats = (targetCard.getAttribute('data-categories') || '').split(',').filter(Boolean);
          if (activeCategory !== 'todas' && !cardCats.includes(activeCategory) && cardCats.length > 0) {
            activeCategory = cardCats[0];
          }
        }
      }

      updateView({ syncHistory: false });

      if (hash.startsWith('#cat-') && catalogSection) {
        requestAnimationFrame(() => catalogSection.scrollIntoView({ behavior: 'smooth', block: 'start' }));
      } else if (hash.startsWith('#herramienta-')) {
        const targetCard = document.getElementById(hash.slice(1));
        if (targetCard) {
          requestAnimationFrame(() => targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' }));
        }
      }
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    function withTransition(update) {
      if (document.startViewTransition && !reduceMotion.matches) {
        document.startViewTransition(update);
      } else {
        update();
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () =>
        withTransition(() => {
          const cat = tab.getAttribute('data-category');
          if (!cat || !validCategories.includes(cat)) return;
          activeCategory = cat;
          if (searchQuery) {
            searchQuery = '';
            if (searchInput) searchInput.value = '';
          }
          updateView({ syncHistory: true });
        })
      );
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        updateView({ syncHistory: true });
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchQuery = '';
        searchInput.value = '';
        searchInput.focus();
        updateView({ syncHistory: true });
      });
    }

    emptySuggestions.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = btn.textContent.trim();
        searchQuery = searchInput.value;
        updateView({ syncHistory: true });
        searchInput.focus();
      });
    });

    window.addEventListener('hashchange', applyStateFromUrl);
    window.addEventListener('popstate', applyStateFromUrl);

    applyStateFromUrl();
  })();
</script>
