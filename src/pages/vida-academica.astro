---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import AcademicGuideCard from '../features/vida-academica/components/AcademicGuideCard.astro';
import ProcedureCard from '../features/vida-academica/components/ProcedureCard.astro';
import CodesInitiativeCard from '../features/vida-academica/components/CodesInitiativeCard.astro';
import DigitalPlatformsGuide from '../features/vida-academica/components/DigitalPlatformsGuide.astro';
import {
  academicTopics,
  universityProcedures,
  codesInitiatives,
} from '../features/vida-academica/data/academicData';

const breadcrumbs = [{ label: 'Vida académica', href: '/vida-academica' }];

const faqs = [
  ...academicTopics.map((topic) => ({
    question: `¿Cómo funciona: ${topic.title}?`,
    answer: `${topic.summary} ${topic.content.join(' ')}`,
  })),
  ...universityProcedures.map((proc) => ({
    question: `¿Cómo tramitar: ${proc.title}?`,
    answer: `${proc.description} Requisitos: ${proc.requirements.join('; ')}. Pasos: ${proc.steps.join(' ')}`,
  })),
];
---

<PageLayout
  title="Vida Académica y Trámites UNLu | CODES"
  description="Guía sobre plataformas oficiales de la UNLu (PlatDig, SAWEB), régimen de cursadas, exámenes finales, correlatividades y trámite del Boleto Estudiantil SUBE."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    <div>
      <Breadcrumbs items={[{ label: 'Vida académica' }]} />

      <SectionHeading
        level={1}
        title="Vida académica"
        subtitle="Funcionamiento de las materias, plataformas oficiales de la UNLu, trámites estudiantiles y reclamos colectivos. Para gestiones formales de expedientes, remitite al Departamento de Alumnos."
        class="mb-2 sm:mb-4"
      />
    </div>

    <!-- NAVEGACIÓN RÁPIDA INTERNA FIJA (sticky bajo el header en móvil y escritorio) -->
    <nav
      class="sticky top-16 z-30 -mx-4 px-4 sm:mx-0 sm:px-3 py-2.5 bg-[var(--color-bg)]/95 backdrop-blur-md border-y sm:border sm:rounded-xl border-[var(--color-border)] flex items-center gap-2 overflow-x-auto whitespace-nowrap text-xs sm:text-sm"
      aria-label="Atajos de la página"
    >
      <a
        href="#plataformas-unlu"
        class="no-underline px-3 py-2 min-h-[40px] inline-flex items-center shrink-0 rounded-lg bg-[var(--brand-50)] dark:bg-[var(--brand-950)] border border-[var(--brand-200)] dark:border-[var(--brand-800)] text-[var(--brand-800)] dark:text-[var(--brand-200)] font-semibold"
      >
        Plataformas UNLu
      </a>
      <a
        href="#orientacion-academica"
        class="no-underline px-3 py-2 min-h-[40px] inline-flex items-center shrink-0 rounded-lg bg-[var(--color-bg-subtle)] hover:bg-[var(--color-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-main)] font-medium"
      >
        Cursadas y finales
      </a>
      <a
        href="#gestiones-oficiales"
        class="no-underline px-3 py-2 min-h-[40px] inline-flex items-center shrink-0 rounded-lg bg-[var(--color-bg-subtle)] hover:bg-[var(--color-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-main)] font-medium"
      >
        Trámites oficiales
      </a>
      <a
        href="#gestiones-codes"
        class="no-underline px-3 py-2 min-h-[40px] inline-flex items-center shrink-0 rounded-lg bg-[var(--color-bg-subtle)] hover:bg-[var(--color-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-main)] font-medium"
      >
        Gestiones CODES
      </a>
    </nav>

    <!-- GUÍA DE PLATAFORMAS DIGITALES DE LA UNLU -->
    <DigitalPlatformsGuide id="plataformas-unlu" />

    <!-- SECCIÓN 1: Orientación Académica -->
    <section id="orientacion-academica" class="space-y-6 pt-8 border-t border-[var(--color-border)]">
      <SectionHeading
        level={2}
        title="Orientación sobre cursadas y exámenes"
        subtitle="Cómo funciona la cursada, qué significa regularizar o promocionar y cómo planificar los exámenes finales."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {academicTopics.map((topic) => <AcademicGuideCard topic={topic} />)}
      </div>
    </section>

    <!-- SECCIÓN 2: Gestiones Universitarias Oficiales -->
    <section id="gestiones-oficiales" class="space-y-6 pt-8 border-t border-[var(--color-border)]">
      <SectionHeading
        level={2}
        title="Gestiones universitarias (UNLu / Provincia)"
        subtitle="Guías paso a paso para realizar trámites formales en los sistemas de la universidad y acceder a beneficios estudiantiles."
      />

      <div class="space-y-6">
        {universityProcedures.map((proc) => <ProcedureCard procedure={proc} />)}
      </div>
    </section>

    <!-- SECCIÓN 3: Gestiones Organizadas por CODES -->
    <section id="gestiones-codes" class="space-y-6 pt-8 border-t border-[var(--color-border)]">
      <SectionHeading
        level={2}
        title="Gestiones e iniciativas organizadas por CODES"
        subtitle="Procesos y reclamos colectivos impulsados por el centro de estudiantes ante los departamentos académicos."
      />

      <div class="space-y-6">
        {codesInitiatives.map((init) => <CodesInitiativeCard initiative={init} />)}
      </div>
    </section>
  </div>
</PageLayout>
