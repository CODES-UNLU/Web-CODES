---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Callout from '../components/ui/Callout.astro';
import CalendarTimeline from '../features/calendario/components/CalendarTimeline.astro';
import { CALENDAR_YEAR } from '../features/calendario/data/calendarEvents';

const breadcrumbs = [{ label: 'Calendario', href: '/calendario' }];
---

<PageLayout
  title={`Calendario Académico ${CALENDAR_YEAR} UNLu | Inscripciones y Finales | CODES`}
  description={`Cronograma ${CALENDAR_YEAR} de la UNLu: períodos de inscripción a materias, turnos de exámenes finales, inicio de clases y receso de invierno.`}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">
    <div>
      <Breadcrumbs items={[{ label: 'Calendario' }]} />

      <SectionHeading
        level={1}
        title="Calendario"
        subtitle={`Cronograma ${CALENDAR_YEAR} de inscripciones a materias, mesas de exámenes finales, cursadas y recesos en la UNLu.`}
      />

      <Callout variant="warning" title={`Estado de las fechas del ciclo ${CALENDAR_YEAR}`}>
        <p>
          Las fechas señaladas como <strong>Confirmada</strong> cuentan con resolución publicada. El resto refleja los períodos habituales del calendario general de la UNLu y puede ajustarse cuando Secretaría Académica publique las resoluciones definitivas de cada sede.
        </p>
      </Callout>
    </div>

    <!-- Timeline vertical accesible con bloque Próximo y períodos pasados colapsables -->
    <div class="pt-2">
      <CalendarTimeline />
    </div>

    <!-- Recomendaciones útiles -->
    <section class="bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-xl p-5 sm:p-6 text-sm text-[var(--color-text-muted)] space-y-2.5">
      <h2 class="font-bold text-base text-[var(--color-text-heading)] m-0">
        Consejos prácticos para las semanas de inscripción
      </h2>
      <ul class="space-y-1.5 list-disc pl-5 leading-relaxed text-[var(--color-text-main)]">
        <li>Comprobá el acceso a tu plataforma académica (SAWEB o Sistema de Gestión de Estudiantes según tu cohorte) varios días antes de la apertura de inscripciones para evitar demoras de restablecimiento de contraseña.</li>
        <li>Tené a mano una opción principal y comisiones alternativas por si se agotan los cupos del horario que preferís.</li>
        <li>Para inscribirte a finales, recordá que el sistema cierra la inscripción 48 horas hábiles antes de la fecha de examen.</li>
      </ul>
    </section>
  </div>
</PageLayout>
