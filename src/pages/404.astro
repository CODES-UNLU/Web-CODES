---
import PageLayout from '../layouts/PageLayout.astro';
import SearchBar from '../components/ui/SearchBar.astro';
import Button from '../components/ui/Button.astro';
import { withBase } from '../lib/paths';
---

<PageLayout
  title="Página no encontrada (404)"
  description="La página que buscás no existe o fue reorganizada en la nueva versión de la web de CODES."
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center space-y-6">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[var(--brand-50)] dark:bg-[var(--brand-950)] text-[var(--brand-700)] dark:text-[var(--brand-300)] font-extrabold text-2xl border border-[var(--brand-200)] dark:border-[var(--brand-800)]" aria-hidden="true">
      404
    </div>

    <div class="space-y-2">
      <h1 class="text-2xl sm:text-4xl font-extrabold text-[var(--color-text-heading)]">
        Página no encontrada
      </h1>
      <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-md mx-auto">
        El enlace que intentaste abrir no existe, cambió de dirección o fue reorganizado en esta nueva versión del sitio.
      </p>
    </div>

    <!-- Buscador directo para que el estudiante no se quede varado -->
    <div class="pt-2 max-w-lg mx-auto">
      <p class="text-xs font-semibold text-[var(--color-text-muted)] mb-2 uppercase tracking-wider">
        Probá buscar lo que necesitás:
      </p>
      <SearchBar />
    </div>

    <div class="pt-6 flex flex-wrap items-center justify-center gap-3">
      <Button href={withBase('/')} variant="primary" size="md">
        <span>Volver al inicio</span>
        <span aria-hidden="true">→</span>
      </Button>
      <Button href={withBase('/ingresantes')} variant="secondary" size="md">
        <span>Ir a Ingresantes</span>
      </Button>
    </div>
  </div>
</PageLayout>
