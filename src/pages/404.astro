---
import PageLayout from '../layouts/PageLayout.astro';
import SearchBar from '../components/ui/SearchBar.astro';
import Button from '../components/ui/Button.astro';
import { withBase } from '../lib/paths';
---

<PageLayout
  title="Página no encontrada (404) | CODES UNLu"
  description="La página que buscás no existe o fue reorganizada en la nueva versión de la web de CODES."
  robots="noindex, follow"
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-16 sm:py-24 space-y-8">
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-heading)] m-0">
        Página no encontrada <span class="code-tag text-[var(--brand-700)] dark:text-[var(--brand-300)]">(404)</span>
      </h1>
      <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-md mx-auto">
        La ruta que intentaste abrir no existe o cambió de dirección en el sitio de CODES. Probá buscando directamente lo que necesitás:
      </p>
    </div>

    <!-- Buscador directo con resultados alineados a la izquierda -->
    <div class="max-w-lg mx-auto">
      <SearchBar idPrefix="notfound-search" />
    </div>

    <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
      <Button href={withBase('/')} variant="primary" size="md">
        <span>Volver al inicio</span>
        <span aria-hidden="true">→</span>
      </Button>
      <Button href={withBase('/ingresantes')} variant="secondary" size="md">
        <span>Ingresantes</span>
      </Button>
      <Button href={withBase('/vida-academica')} variant="outline" size="md">
        <span>Vida académica</span>
      </Button>
      <Button href={withBase('/calendario')} variant="outline" size="md">
        <span>Calendario</span>
      </Button>
      <Button href={withBase('/herramientas')} variant="outline" size="md">
        <span>Herramientas</span>
      </Button>
    </div>
  </div>
</PageLayout>
